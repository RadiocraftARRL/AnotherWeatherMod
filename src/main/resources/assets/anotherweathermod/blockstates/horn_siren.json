        "facing": "north"
      },
      "apply": {
        "model": "anotherweathermod:block/horn_siren_upper"
      }
    },
    {
      "when": {
        "segment": "1",
        "facing": "east"
      },
      "apply": {
        "model": "anotherweathermod:block/horn_siren_upper",
        "y": 90
      }
    },
    {
      "when": {
        "segment": "1",
        "facing": "south"
      },
      "apply": {
        "model": "anotherweathermod:block/horn_siren_upper",
        "y": 180
      }
    },
    {
      "when": {
        "segment": "1",
        "facing": "west"
