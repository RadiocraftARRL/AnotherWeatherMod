{
  "multipart": [
    {
      "when": {
        "segment": "0",
        "facing": "north"
      },
      "apply": {
        "model": "anotherweathermod:block/horn_siren_lower"
      }
    },
    {
      "when": {
        "segment": "0",
        "facing": "east"
      },
      "apply": {
        "model": "anotherweathermod:block/horn_siren_lower",
        "y": 90
      }
    },
    {
      "when": {
        "segment": "0",
        "facing": "south"
      },
      "apply": {
        "model": "anotherweathermod:block/horn_siren_lower",
        "y": 180
